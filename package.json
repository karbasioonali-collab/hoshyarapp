{
  "name": "hoshyarapp",
  "private": true,
  "version": "0.1.0",
  "description": "هوشیار (HOSHYAR) - دستیار مالی شخصی هوشمند",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "db:generate": "npm run generate --workspace=packages/database",
    "db:migrate": "npm run migrate --workspace=packages/database",
    "db:seed": "npm run seed --workspace=packages/database",
    "build:backend": "npm run build --workspace=apps/backend",
    "build:admin": "npm run build --workspace=apps/admin"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react-native": "0.74.5",
    "react": "18.2.0",
    "react-native-reanimated": "~3.10.1"
  }
}
